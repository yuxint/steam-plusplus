<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  页头横幅：改为纯透明，去掉旧版游戏封面拼贴背景  -->
    <SolidColorBrush x:Key="PageHeaderBackgroundBrush" Color="Transparent" />

    <LinearGradientBrush x:Key="HeaderOpacityMaskBrush" StartPoint="0,0" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#FF000000" />
        <GradientStop Offset="0.8" Color="#FF000000" />
        <GradientStop Offset="0.83" Color="#EE000000" />
        <GradientStop Offset="0.86" Color="#DD000000" />
        <GradientStop Offset="0.89" Color="#BB000000" />
        <GradientStop Offset="0.92" Color="#85000000" />
        <GradientStop Offset="1" Color="#00000000" />
    </LinearGradientBrush>

    <!--  苹果极简风深色调色板  -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#FF1A1A1C" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FF1A1A1C" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="#FF1A1A1C" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FF232326" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#FF28282C" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#B32A2A2E" />

    <!--  NavigationView 别名键（FA 内部为 StaticResource 别名，必须直接覆盖）  -->
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FF232326" />
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FF232326" />
    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#FF232326" />
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FF1A1A1C" />

    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FF38383C" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#FF38383C" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FF333338" />

    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0AFFFFFF" />

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFF5F5F7" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFC7C7CC" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF98989D" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#FF5A5A5E" />

    <!--  控件圆角整体调大，贴近 macOS   -->
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>

    <LinearGradientBrush x:Key="SkeletonStartAnimationBackground" StartPoint="0%,100%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#FF1C1F23" />
        <GradientStop Offset="0" Color="#FF2E3238" />
        <GradientStop Offset="1" Color="#FF1C1F23" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SkeletonEndAnimationBackground" StartPoint="0%,100%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#FF1C1F23" />
        <GradientStop Offset="1" Color="#FF2E3238" />
        <GradientStop Offset="1" Color="#FF1C1F23" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SkeletonDefaultBackground" Color="#FF1C1F23" />
</ResourceDictionary>
