<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  页头横幅：改为纯透明，去掉旧版游戏封面拼贴背景  -->
    <SolidColorBrush x:Key="PageHeaderBackgroundBrush" Color="Transparent" />

    <LinearGradientBrush x:Key="HeaderOpacityMaskBrush" StartPoint="0,0" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#FF000000" />
        <GradientStop Offset="0.8" Color="#FF000000" />
        <GradientStop Offset="0.83" Color="#EE000000" />
        <GradientStop Offset="0.86" Color="#DD000000" />
        <GradientStop Offset="0.89" Color="#BB000000" />
        <GradientStop Offset="0.92" Color="#85000000" />
        <GradientStop Offset="1" Color="#00000000" />
    </LinearGradientBrush>

    <!--  苹果极简风浅色调色板  -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="#FFF5F5F7" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FFF5F5F7" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#FFEFEFF2" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#B3FFFFFF" />

    <!--  NavigationView 别名键（FA 内部为 StaticResource 别名，必须直接覆盖）  -->
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FFF5F5F7" />
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FFF5F5F7" />
    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#FFF5F5F7" />
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FFE5E5EA" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#FFE5E5EA" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FFE5E5EA" />

    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFF5F5F7" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FFF0F0F3" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FFE8E8ED" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#FFF5F5F7" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#14000000" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0F000000" />

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FF1D1D1F" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF6E6E73" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF86868B" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#FFAEAEB2" />

    <!--  控件圆角整体调大，贴近 macOS   -->
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>

    <LinearGradientBrush x:Key="SkeletonStartAnimationBackground" StartPoint="0%,100%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#FFF9F9F9" />
        <GradientStop Offset="0" Color="#FFE6E8EA" />
        <GradientStop Offset="1" Color="#FFF9F9F9" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SkeletonEndAnimationBackground" StartPoint="0%,100%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#FFF9F9F9" />
        <GradientStop Offset="1" Color="#FFE6E8EA" />
        <GradientStop Offset="1" Color="#FFF9F9F9" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SkeletonDefaultBackground" Color="#FFF9F9F9" />
</ResourceDictionary>
